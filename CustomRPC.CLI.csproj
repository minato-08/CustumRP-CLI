<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>customrp</AssemblyName>
    <RootNamespace>CustomRPC.CLI</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Version>1.19.2</Version>
    <Description>Custom Discord Rich Presence Manager - CLI version for macOS/Linux/Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lachee's Discord RPC library (cross-platform) -->
    <PackageReference Include="DiscordRichPresence" Version="1.2.1.24" />
  </ItemGroup>
</Project>
